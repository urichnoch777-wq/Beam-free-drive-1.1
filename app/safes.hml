<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<title>SoftBeam Drive 3D</title>
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<style>
html,body{margin:0;height:100%;overflow:hidden;background:#9ed0ff;color:#10202e;font:600 15px/1.2 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;touch-action:none;-webkit-tap-highlight-color:transparent}
canvas{position:fixed;inset:0;width:100%;height:100%;display:block}
.ui{position:fixed;background:rgba(255,255,255,.8)}
#hud{left:10px;top:calc(env(safe-area-inset-top,0px) + 10px);padding:6px 10px;border-radius:12px;font-variant-numeric:tabular-nums}
#hud b{font-size:20px}#hud small{opacity:.7;font-size:12px}
#top{right:10px;top:calc(env(safe-area-inset-top,0px) + 10px);display:flex;gap:6px;background:none}
button{font:inherit;color:inherit;border:0;border-radius:14px;background:rgba(255,255,255,.8);cursor:pointer}
#top button{width:42px;height:42px;font-size:19px}
.pd{position:fixed;bottom:calc(env(safe-area-inset-bottom,0px) + 16px);width:84px;height:84px;font-size:30px;line-height:1;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:22px}
.pd small{font-size:11px;opacity:.7}.pd.on{background:#fff;transform:scale(.95)}
#bl{left:10px}#br{left:102px}#bg{right:10px}#bb{right:102px}
#hint{left:50%;top:22%;transform:translateX(-50%);padding:8px 14px;border-radius:14px;pointer-events:none;white-space:nowrap}
</style>
<script type="importmap">{"imports":{"three":"https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js"}}</script>
</head>
<body>
<div id="hud" class="ui"><b id="spd">0</b> км/ч<br><small>урон <span id="dmg">0</span>% · <span id="dst">0</span> м</small></div>
<div id="top" class="ui"><button id="rep">🔧</button><button id="rst">⏮</button><button id="bm">🕸</button></div>
<div id="hint" class="ui">Жми ▲ и разбей машину о стену</div>
<button class="pd" id="bl">◀</button><button class="pd" id="br">▶</button>
<button class="pd" id="bb">▼<small>тормоз</small></button><button class="pd" id="bg">▲<small>газ</small></button>
<script type="module">
import * as THREE from 'three';
const $=id=>document.getElementById(id);

// ===== Константы (метры, секунды) =====
const DT=1/360,IT=10,G=9.81,L0=.39,WR=.34,KS=550,CD=55,AD=26,VMAX=28,GRIP=.06,GCAP=49*DT;
const X0=-78,X1=78,Z0=-282,Z1=42,CELL=1.5;

// ===== Рельеф: холмы + трамплины =====
const RAMPS=[[-14,-40,10,34,3],[16,-95,10,40,4.5],[-10,-150,12,50,6],[0,-215,12,60,7]]; // x, z начала, ширина, длина, высота
const sm=(a,b,x)=>{x=Math.min(1,Math.max(0,(x-a)/(b-a)));return x*x*(3-2*x)};
function H(x,z){
 let h=sm(20,70,Math.hypot(x,z))*(2.2*Math.sin(x*.03+1)*Math.cos(z*.027)+1.1*Math.sin(z*.08+x*.05));
 for(const[rx,rz,w,l,rh]of RAMPS){const u=(rz-z)/l;if(u>0&&u<1)h+=u*rh*sm(0,1.5,w/2-Math.abs(x-rx))}
 return h}
const gn=(x,z)=>{const e=.5,dx=H(x+e,z)-H(x-e,z),dz=H(x,z+e)-H(x,z-e),l=Math.hypot(dx,2*e,dz);return[-dx/l,2*e/l,-dz/l]};

// ===== Сцена =====
const rend=new THREE.WebGLRenderer({antialias:true});rend.setPixelRatio(Math.min(devicePixelRatio,2));document.body.prepend(rend.domElement);
const scene=new THREE.Scene();scene.background=new THREE.Color(0x9ed0ff);scene.fog=new THREE.Fog(0x9ed0ff,70,260);
const cam=new THREE.PerspectiveCamera(60,1,.1,500);
scene.add(new THREE.HemisphereLight(0xffffff,0x5a7a45,1.2));
const sun=new THREE.DirectionalLight(0xffffff,1.8);sun.position.set(40,80,30);scene.add(sun);
function rs(){rend.setSize(innerWidth,innerHeight);cam.aspect=innerWidth/innerHeight;cam.fov=cam.aspect<1?78:60;cam.updateProjectionMatrix()}
addEventListener('resize',rs);rs();
const mat=c=>new THREE.MeshLambertMaterial({color:c});

{const g=new THREE.PlaneGeometry(X1-X0,Z1-Z0,(X1-X0)/CELL,(Z1-Z0)/CELL);g.rotateX(-Math.PI/2);g.translate((X0+X1)/2,0,(Z0+Z1)/2);
 const p=g.attributes.position,c=new Float32Array(p.count*3);
 for(let i=0;i<p.count;i++){const x=p.getX(i),z=p.getZ(i);p.setY(i,H(x,z));
  const t=Math.min(1,(1-gn(x,z)[1])*7),k=.85+.15*Math.sin(x*.7)*Math.cos(z*.6);
  c[3*i]=(.32+.3*t)*k;c[3*i+1]=(.58-.1*t)*k;c[3*i+2]=(.28+.05*t)*k}
 g.setAttribute('color',new THREE.BufferAttribute(c,3));g.computeVertexNormals();
 scene.add(new THREE.Mesh(g,new THREE.MeshLambertMaterial({vertexColors:true})))}

// ===== Статичные препятствия (бетон и ящики) =====
const BOX=[];
function addBox(cx,cz,sx,sy,sz,col,by){const e=by===undefined,y0=e?H(cx,cz)-2:by,y1=e?y0+2+sy:y0+sy;
 BOX.push({x0:cx-sx/2,x1:cx+sx/2,y0,y1,z0:cz-sz/2,z1:cz+sz/2});
 const m=new THREE.Mesh(new THREE.BoxGeometry(sx,y1-y0,sz),mat(col));m.position.set(cx,(y0+y1)/2,cz);scene.add(m)}
addBox(0,-70,16,3,1,0x9aa0a6);
addBox(10,-190,14,3,1,0x9aa0a6);
for(let i=0;i<5;i++)addBox(-14+i*7,-125,3,1.6,3,0x8d9399);
{const g0=H(30,-100)-.5;for(let r=0;r<4;r++)for(let c=0;c<4-r;c++)addBox(30+(c-(3-r)/2)*2.1,-100,2,2,2,0xb98a4e,g0+r*2)}

// ===== Векторы =====
const dot=(a,b)=>a[0]*b[0]+a[1]*b[1]+a[2]*b[2],sub=(a,b)=>[a[0]-b[0],a[1]-b[1],a[2]-b[2]],
 nrm=a=>{const l=Math.hypot(a[0],a[1],a[2])||1;return[a[0]/l,a[1]/l,a[2]/l]},
 crs=(a,b)=>[a[1]*b[2]-a[2]*b[1],a[2]*b[0]-a[0]*b[2],a[0]*b[1]-a[1]*b[0]];

// ===== Машина: решётка 6x3x2 узлов, балки = все пары ближе 1.9 м =====
const COLX=[0,.9,1.5,2.5,3.1,4],TOPY=[.62,.66,1.2,1.2,.8,.7],MIDY=.42,HW=.8,NN=36;
const id=(i,j,k)=>(i*3+j)*2+k;
let P,Bm,nc,F=[0,0,-1],U=[0,1,0],Rr=[1,0,0],C=[0,1,0],vel=[0,0,0],spd=0,steer=0,spin=0,vis=true;
function mk(ox,oz){
 P=[];Bm=[];const oy=H(ox,oz)+.9;
 for(let i=0;i<6;i++)for(let j=0;j<3;j++)for(let k=0;k<2;k++){
  const lx=COLX[i]-2,ly=j?(j==1?MIDY:TOPY[i]):0,lz=k?HW:-HW;
  P.push({x:ox+lz,y:oy+ly,z:oz-lx,px:ox+lz,py:oy+ly,pz:oz-lx,w:i>3?.5:1,r:.12,mu:.5,i,j,k})}
 for(let a=0;a<NN;a++)for(let b=a+1;b<NN;b++){const p=P[a],q=P[b],L=Math.hypot(p.x-q.x,p.y-q.y,p.z-q.z);
  if(L<1.9){const m=(COLX[p.i]+COLX[q.i])/2,cr=m<1||m>3,df=cr?.03:.06;
   Bm.push({a,b,L,L0:L,k:1-Math.pow(.1,1/IT),df,df0:df,br:cr?.3:.4})}}
 nc=Bm.length}
// колёса: узлы крепления подвески (нижний + средний узел у оси)
const WH=[[1,0],[1,1],[4,0],[4,1]].map(([i,k])=>({a:id(i,0,k),b:id(i,1,k),f:i==4?1:0,s:k?1:-1,d:L0}));

function axes(){
 const av=f=>{let x=0,y=0,z=0,n=0;for(const p of P)if(f(p)){x+=p.x;y+=p.y;z+=p.z;n++}return[x/n,y/n,z/n]};
 F=nrm(sub(av(p=>p.i>3),av(p=>p.i<2)));
 let u=sub(av(p=>p.j==2),av(p=>p.j==0));const d=dot(u,F);
 U=nrm([u[0]-F[0]*d,u[1]-F[1]*d,u[2]-F[2]*d]);Rr=crs(F,U);C=av(()=>1);
 let vx=0,vy=0,vz=0;for(const p of P){vx+=p.x-p.px;vy+=p.y-p.py;vz+=p.z-p.pz}
 vel=[vx/NN/DT,vy/NN/DT,vz/NN/DT];spd=Math.hypot(vel[0],vel[1],vel[2])}

function ground(x,y,z){let h=H(x,z);for(const b of BOX)if(x>b.x0&&x<b.x1&&z>b.z0&&z<b.z1&&y>b.y1-.3&&b.y1>h)h=b.y1;return h}

// подвеска + тяга + боковое сцепление (рейкаст-колёса на мягком кузове)
function wheels(thr,st){
 for(const w of WH){const A=P[w.a],B=P[w.b];
  const d=(A.y-ground(A.x,A.y,A.z))/Math.max(.5,U[1]);w.d=d;const x=L0-d;if(x<=0)continue;
  const vx=(A.x-A.px)/DT,vy=(A.y-A.py)/DT,vz=(A.z-A.pz)/DT,ld=Math.min(1,x/.1);
  const sp=Math.min(160,Math.max(0,KS*x-CD*(vx*U[0]+vy*U[1]+vz*U[2])))*DT*DT;
  const co=w.f?Math.cos(st):1,si=w.f?Math.sin(st):0;
  const f=[F[0]*co+Rr[0]*si,F[1]*co+Rr[1]*si,F[2]*co+Rr[2]*si],l=[Rr[0]*co-F[0]*si,Rr[1]*co-F[1]*si,Rr[2]*co-F[2]*si];
  const vl=vx*f[0]+vy*f[1]+vz*f[2],vt=vx*l[0]+vy*l[1]+vz*l[2];
  const dl=Math.max(-GCAP,Math.min(GCAP,-vt*GRIP))*ld*DT;
  let dv=0,ac=0;
  if(thr>0){if(vl<VMAX)ac=AD}else if(thr<0){if(vl>1)dv=-Math.min(vl,40*DT);else if(vl>-9)ac=-AD*.6}else dv=-vl*.002;
  const ta=ac*ld*DT*DT,tv=dv*ld*DT;
  for(const n of[A,B]){
   n.x+=U[0]*sp+f[0]*ta;n.y+=U[1]*sp+f[1]*ta;n.z+=U[2]*sp+f[2]*ta;
   n.px-=l[0]*dl+f[0]*tv;n.py-=l[1]*dl+f[1]*tv;n.pz-=l[2]*dl+f[2]*tv}}}

// контакт узла с поверхностью: вытолкнуть + трение Кулона
function hit(p,nx,ny,nz,d){
 p.x+=nx*d;p.y+=ny*d;p.z+=nz*d;
 let vx=p.x-p.px,vy=p.y-p.py,vz=p.z-p.pz;const vn=vx*nx+vy*ny+vz*nz;vx-=vn*nx;vy-=vn*ny;vz-=vn*nz;
 const t=Math.hypot(vx,vy,vz),k=t>1e-9?Math.max(0,t-p.mu*d)/t:0;
 p.px=p.x-vx*k;p.py=p.y-vy*k;p.pz=p.z-vz*k}
function collide(p){
 p.x=Math.min(X1,Math.max(X0,p.x));p.z=Math.min(Z1,Math.max(Z0,p.z));
 const n=gn(p.x,p.z),s=(p.y-H(p.x,p.z))*n[1];
 if(s<p.r)hit(p,n[0],n[1],n[2],p.r-s);
 for(const b of BOX){const r=p.r;
  if(p.x<b.x0-r||p.x>b.x1+r||p.y<b.y0-r||p.y>b.y1+r||p.z<b.z0-r||p.z>b.z1+r)continue;
  const a=[p.x-b.x0+r,b.x1+r-p.x,p.y-b.y0+r,b.y1+r-p.y,p.z-b.z0+r,b.z1+r-p.z];
  let m=0;for(let i=1;i<6;i++)if(a[i]<a[m])m=i;
  const v=[0,0,0];v[m>>1]=m&1?1:-1;hit(p,v[0],v[1],v[2],a[m])}}

function step(thr,st){
 const g=G*DT*DT;
 for(const p of P){const vx=(p.x-p.px)*.9998,vy=(p.y-p.py)*.9998,vz=(p.z-p.pz)*.9998;p.px=p.x;p.py=p.y;p.pz=p.z;p.x+=vx;p.y+=vy-g;p.z+=vz}
 wheels(thr,st);
 for(let it=0;it<IT;it++)for(const b of Bm){if(b.dead)continue;
  const a=P[b.a],c=P[b.b],dx=c.x-a.x,dy=c.y-a.y,dz=c.z-a.z,d=Math.hypot(dx,dy,dz)||1e-6;
  if(!it){const s=(d-b.L)/b.L;
   if(s>b.df||s<-b.df){ // пластическая деформация (beamDeform) и разрыв (beamStrength)
    if(Math.abs(s)>b.br){b.dead=1;continue}
    b.L=Math.max(b.L0*.4,b.L*(1+(s>0?s-b.df:s+b.df)));b.df=Math.min(b.df0*2,b.df*1.02);
    if(Math.abs(b.L/b.L0-1)>.5){b.dead=1;continue}}}
  const f=(d-b.L)/d*b.k/(a.w+c.w);
  a.x+=dx*f*a.w;a.y+=dy*f*a.w;a.z+=dz*f*a.w;c.x-=dx*f*c.w;c.y-=dy*f*c.w;c.z-=dz*f*c.w}
 for(const p of P)collide(p)}

// ===== Графика машины =====
mk(0,0);axes();
const bi=[],gi=[],quad=(gl,a,b,c,d)=>(gl?gi:bi).push(a,b,c,a,c,d);
for(let i=0;i<5;i++){
 for(let j=0;j<2;j++){const gl=j==1&&i>0&&i<4;
  quad(gl,id(i,j,1),id(i+1,j,1),id(i+1,j+1,1),id(i,j+1,1));
  quad(gl,id(i,j,0),id(i,j+1,0),id(i+1,j+1,0),id(i+1,j,0))}
 const gt=i==1||i==3;
 quad(gt,id(i,2,0),id(i,2,1),id(i+1,2,1),id(i+1,2,0));
 quad(0,id(i,0,0),id(i+1,0,0),id(i+1,0,1),id(i,0,1))}
for(let j=0;j<2;j++){quad(0,id(5,j,0),id(5,j+1,0),id(5,j+1,1),id(5,j,1));quad(0,id(0,j,0),id(0,j,1),id(0,j+1,1),id(0,j+1,0))}
const bg=new THREE.BufferGeometry(),pos=new THREE.BufferAttribute(new Float32Array(NN*3),3);
bg.setAttribute('position',pos);bg.setIndex(bi.concat(gi));bg.addGroup(0,bi.length,0);bg.addGroup(bi.length,gi.length,1);
const bodyMat=new THREE.MeshLambertMaterial({color:0xd8453b,side:THREE.DoubleSide});
const body=new THREE.Mesh(bg,[bodyMat,new THREE.MeshLambertMaterial({color:0x9fd2ff,transparent:true,opacity:.7,side:THREE.DoubleSide})]);
body.frustumCulled=false;scene.add(body);
const NB=Bm.length,lp=new THREE.BufferAttribute(new Float32Array(NB*6),3),lc=new THREE.BufferAttribute(new Float32Array(NB*6),3),lg=new THREE.BufferGeometry();
lg.setAttribute('position',lp);lg.setAttribute('color',lc);
const lines=new THREE.LineSegments(lg,new THREE.LineBasicMaterial({vertexColors:true}));lines.frustumCulled=false;scene.add(lines);
const wg=new THREE.CylinderGeometry(WR,WR,.26,20);wg.rotateX(Math.PI/2);
const tireM=mat(0x1d1d21),rimM=mat(0xc9ced4),spokeG=new THREE.BoxGeometry(.6,.07,.28),wm=[];
for(let q=0;q<4;q++){const m=new THREE.Mesh(wg,tireM);m.matrixAutoUpdate=false;m.frustumCulled=false;
 for(const rz of[0,Math.PI/2]){const s=new THREE.Mesh(spokeG,rimM);s.rotation.z=rz;m.add(s)}scene.add(m);wm.push(m)}
const mt=new THREE.Matrix4(),mr=new THREE.Matrix4(),vF=new THREE.Vector3(),vU=new THREE.Vector3(),vL=new THREE.Vector3(),col=new THREE.Color();

function sync(){
 const a=pos.array;for(let q=0;q<NN;q++){a[3*q]=P[q].x;a[3*q+1]=P[q].y;a[3*q+2]=P[q].z}
 pos.needsUpdate=true;bg.computeVertexNormals();
 if(vis){const la=lp.array,ca=lc.array;
  for(let q=0;q<NB;q++){const b=Bm[q],A=P[b.a],B=b.dead?A:P[b.b];
   la.set([A.x,A.y,A.z,B.x,B.y,B.z],q*6);
   col.setHSL((1-Math.min(1,Math.abs(b.L/b.L0-1)*3))*.36,.9,.5);ca.set([col.r,col.g,col.b,col.r,col.g,col.b],q*6)}
  lp.needsUpdate=lc.needsUpdate=true}
 for(let q=0;q<4;q++){const w=WH[q],A=P[w.a],co=w.f?Math.cos(steer):1,si=w.f?Math.sin(steer):0,dd=Math.min(w.d,L0)-WR,o=w.s*.14;
  mt.makeBasis(vF.set(F[0]*co+Rr[0]*si,F[1]*co+Rr[1]*si,F[2]*co+Rr[2]*si),vU.set(U[0],U[1],U[2]),vL.set(Rr[0]*co-F[0]*si,Rr[1]*co-F[1]*si,Rr[2]*co-F[2]*si));
  mt.setPosition(A.x-U[0]*dd+Rr[0]*o,A.y-U[1]*dd+Rr[1]*o,A.z-U[2]*dd+Rr[2]*o);
  mt.multiply(mr.makeRotationZ(spin));wm[q].matrix.copy(mt);wm[q].matrixWorldNeedsUpdate=true}}

function follow(dt,snap){
 const l=Math.hypot(F[0],F[2])||1,k=snap?1:1-Math.exp(-dt*3),p=cam.position;
 p.x+=(C[0]-F[0]/l*9-p.x)*k;p.y+=(C[1]+3.6-p.y)*k;p.z+=(C[2]-F[2]/l*9-p.z)*k;
 p.y=Math.max(p.y,H(p.x,p.z)+1);cam.lookAt(C[0]+F[0]/l*3,C[1]+1,C[2]+F[2]/l*3)}

function hud(){
 $('spd').textContent=Math.round(spd*3.6);
 let d=0;for(let i=0;i<nc;i++){const b=Bm[i];d+=b.dead?1:Math.min(1,Math.abs(b.L/b.L0-1)*2)}
 $('dmg').textContent=Math.min(100,Math.round(d/nc*600));$('dst').textContent=Math.max(0,Math.round(-C[2]))}

// ===== Управление =====
const inp={l:0,r:0,g:0,b:0};
for(const[bid,k]of[['bl','l'],['br','r'],['bg','g'],['bb','b']]){const e=$(bid),set=v=>{inp[k]=v;e.classList.toggle('on',!!v);if(v)$('hint').style.display='none'};
 e.addEventListener('pointerdown',ev=>{ev.preventDefault();set(1)});
 for(const t of['pointerup','pointercancel','pointerleave'])e.addEventListener(t,()=>set(0))}
const KEY={ArrowLeft:'l',a:'l',ArrowRight:'r',d:'r',ArrowUp:'g',w:'g',ArrowDown:'b',s:'b'};
addEventListener('keydown',e=>{if(KEY[e.key])inp[KEY[e.key]]=1});
addEventListener('keyup',e=>{if(KEY[e.key])inp[KEY[e.key]]=0});
addEventListener('contextmenu',e=>e.preventDefault());
function spawn(x,z){mk(Math.max(X0+4,Math.min(X1-4,x)),Math.max(Z0+6,Math.min(Z1-6,z)));axes();steer=0}
$('rep').onclick=()=>spawn(C[0],C[2]);
$('rst').onclick=()=>{spawn(0,0);follow(0,1)};
$('bm').onclick=()=>{vis=!vis;lines.visible=vis;bodyMat.transparent=vis;bodyMat.opacity=vis?.4:1};
bodyMat.transparent=true;bodyMat.opacity=.4;

// ===== Главный цикл =====
let last=performance.now(),acc=0;
function loop(t){requestAnimationFrame(loop);
 const dt=Math.min(.05,(t-last)/1000);last=t;acc+=dt;
 const thr=inp.g-inp.b;steer+=((inp.r-inp.l)*.5/(1+spd/12)-steer)*Math.min(1,dt*8);
 axes();let n=0;while(acc>=DT&&n<18){step(thr,steer);acc-=DT;n++}if(n>=18)acc=0;
 axes();spin-=(vel[0]*F[0]+vel[1]*F[1]+vel[2]*F[2])*dt/WR;
 sync();follow(dt,0);hud();rend.render(scene,cam)}
follow(0,1);requestAnimationFrame(loop);
</script>
</body>
</html>
